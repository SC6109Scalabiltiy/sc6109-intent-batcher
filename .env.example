# Copy this file to .env and fill in local values.
# Never commit .env or any real private key.

# Public Sepolia RPC. For long benchmark sweeps, replace it with your own
# Alchemy, Infura, QuickNode, or other provider URL to avoid rate limits.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Disposable Sepolia-only deployer/coordinator key.
# Use a fresh account funded with only the test ETH needed for this project.
DEPLOYER_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY

# Optional explorer verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional run parameters used by deployment, seeding, coordinator, or benchmark scripts.
AGENT_COUNT=50
INTENT_AMOUNT_USDC=10
MAX_BATCH_SIZE=50
INTENT_INTERVAL_SECONDS=3600
INTENT_DEADLINE_WINDOW_SECONDS=900
INTENT_MAX_EXECUTIONS=1
OUTPUT_LIQUIDITY_WETH=100

# ERC-4337 paymaster deposit pre-funded at deploy time (in ETH).
# The deployer must hold this much ETH in addition to deploy gas.
PAYMASTER_PREFUND_ETH=0.1

# Frontend/backend defaults
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
NEXT_PUBLIC_COORDINATOR_API_URL=http://127.0.0.1:4000
